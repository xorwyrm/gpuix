+/// Creates a grain of fine noise, as on frosted glass or paper: soft mottling
+/// with features about `cell` device pixels across. Above the middle it shows
+/// `light` and below it `dark`, at up to their full alpha, so most of it is
+/// faint. A `sparkle` fraction of `cell`-wide squares (0 to 1) show `light` at
+/// four times its alpha instead, like the bright pits of frosted glass.
+///
+/// The grain is anchored to the quad's origin, so it moves with the quad.
+pub fn grain(light: impl Into<Hsla>, dark: impl Into<Hsla>, cell: f32, sparkle: f32) -> Background {
+    Background {
+        tag: BackgroundTag::Grain,
+        gradient_angle_or_pattern_height: cell.max(1.0),
+        colors: [
+            LinearColorStop {
+                color: light.into(),
+                percentage: sparkle.clamp(0.0, 1.0),
+            },
+            LinearColorStop {
+                color: dark.into(),
+                percentage: 0.0,
+            },
+        ],
+        ..Default::default()
+    }
+}
