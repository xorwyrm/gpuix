+// A content mask: the rect content is clipped to, and a rounded rect it must
+// also lie within. `rounded_bounds` can reach past `bounds` after a rect mask
+// inside a rounded one; all-zero radii make the mask a plain rect.
+struct ContentMask {
+    Bounds bounds;
+    Bounds rounded_bounds;
+    Corners corner_radii;
+};
+
+// How much of the pixel at `position` a content mask keeps. Its rect is clipped
+// by SV_ClipDistance, so only rounded corners are left to cut here.
+float mask_coverage(float2 position, ContentMask mask) {
+    Corners radii = mask.corner_radii;
+    if (max(max(radii.top_left, radii.top_right), max(radii.bottom_right, radii.bottom_left)) <= 0.0) {
+        return 1.0;
+    }
+    return saturate(0.5 - quad_sdf(position, mask.rounded_bounds, radii));
+}
+
+// `color`, in straight alpha, as a pixel at `position` keeps it inside `mask`.
+float4 clip_to_mask(float4 color, float2 position, ContentMask mask) {
+    return float4(color.rgb, color.a * mask_coverage(position, mask));
